OPENAI_API_KEY=<key>
OPENAI_TRANSCRIPTION_API_KEY=<key>
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_API_MODEL=google/gemini-3-flash-preview
RUST_BOT_TEMPLATES_DIR=/path/to/rust-bot/templates

# For testing
MCP_SERVER_URL=https://...
MCP_HEADERS_JWT=<key>
MCP_TEST_PROMPT="Please list all event types and their descriptions"

# Search
BRAVE_API_KEY=<key>

RUST_LOG=info
RUST_LOG_FILE=./logs/rust-bot.log

# Anthropic API
ANTHROPIC_API_KEY=<key>
ANTHROPIC_API_BASE=https://api.anthropic.com
ANTHROPIC_API_MODEL=claude-sonnet-5

# Channel related
GROQ_TRANSCRIPTION_API_KEY=<key>
GROK_MODEL=x-ai/grok-4.5

# Email channel (Gmail IMAP + SMTP) — used by configs/channels/config_anthropic_email.json
# Username / from: your full Gmail address
# Password: a Google App Password (not your normal Gmail password).
IMAP_HOST=imap.gmail.com
IMAP_USERNAME=your.name@gmail.com
IMAP_PASSWORD=<gmail-app-password>
IMAP_MAILBOX=INBOX
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=your.name@gmail.com
SMTP_PASSWORD=<gmail-app-password>
FROM_ADDRESS=your.name@gmail.com

# Strapi MCP token
STRAPI_MCP_TOKEN=<key>
