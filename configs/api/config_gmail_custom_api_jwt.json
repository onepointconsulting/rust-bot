{
  "agents": {
    "workspace": "${AGENTS_WORKSPACE}",
    "model": "${AGENTS_MODEL}",
    "provider": "auto",
    "maxTokens": 32768,
    "contextWindowTokens": 131072,
    "temperature": 0.1,
    "maxToolIterations": 100,
    "maxToolResultChars": 16000,
    "providerRetryMode": "standard",
    "reasoningEffort": null,
    "timezone": "UTC",
    "dream": {
      "intervalH": 2,
      "modelOverride": null,
      "maxBatchSize": 20,
      "maxIterations": 10
    },
    "modelPreset": "primary"
  },
  "channels": {
    "streaming": false,
    "sendProgress": true,
    "sendToolHints": true,
    "sendMaxRetries": 3,
    "transcriptionProvider": "groq",
    "allowFrom": [
      "*"
    ]
  },
  "providers": {
    "custom": {
      "apiKey": "${PROVIDER_CUSTOM_API_KEY}",
      "apiBase": "https://api.edenai.run/v3",
      "extraHeaders": null
    },
    "azureOpenai": {
      "apiKey": "",
      "apiBase": null,
      "extraHeaders": null
    },
    "anthropic": {
      "apiKey": "",
      "apiBase": null,
      "extraHeaders": null
    },
    "openai": {
      "apiKey": "",
      "apiBase": null,
      "extraHeaders": null
    },
    "openrouter": {
      "apiKey": "",
      "apiBase": null,
      "extraHeaders": null
    },
    "gemini": {
      "apiKey": "",
      "apiBase": null,
      "extraHeaders": null
    },
    "groq": {
      "apiKey": "",
      "apiBase": null,
      "extraHeaders": null
    }
  },
  "api": {
    "host": "0.0.0.0",
    "port": 8900,
    "timeout": 120.0,
    "jwt": {
      "enabled": true,
      "privateKeyPath": ".rust-bot/credentials/private_key.pem",
      "publicKeyPath": ".rust-bot/credentials/public_key.pem",
      "iss": "rust-bot",
      "aud": "onepoint-newsletter"
    },
    "usersFile": ".rust-bot/users.json",
    "cors": {
      "enabled": true,
      "origins": [
        "*"
      ]
    },
    "webRoot": null
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 18790,
    "heartbeat": {
      "enabled": true,
      "intervalS": 1800,
      "keepRecentMessages": 8
    }
  },
  "tools": {
    "web": {
      "enable": true,
      "proxy": null,
      "timeout": 60,
      "search": {
        "provider": "brave",
        "apiKey": "${BRAVE_API_KEY}",
        "baseUrl": "",
        "maxResults": 20,
        "timeout": 30
      }
    },
    "exec": {
      "enable": true,
      "timeout": 60,
      "pathAppend": "",
      "sandbox": ""
    },
    "restrictToWorkspace": false,
    "mcpServers": {},
    "ssrfWhitelist": [],
    "gmail": {
      "enable": true,
      "clientSecretPath": ".rust-bot/workspace/credentials/client_secret.json",
      "tokenCachePath": ".rust-bot/workspace/credentials/token_cache.json",
      "maxResults": 20
    },
    "docx": {
      "enable": false
    },
    "ocr": {
      "enable": false,
      "model": "claude-sonnet-4-6",
      "baseUrl": "https://api.anthropic.com",
      "provider": "anthropic",
      "apiKey": ""
    },
    "imageGeneration": {
      "enable": false,
      "model": "openai/gpt-image-2",
      "apiKey": "",
      "baseUrl": "https://openrouter.ai/api/v1/images",
      "size": "",
      "quality": ""
    }
  },
  "subagent": {
    "failOnToolError": true
  },
  "examplePrompts": [
    "Can you please use the onepoint-newsletter-skill to generate a draft message and send it to gil.fernandes@onepointltd.com. Please use all of the relevant emails in the mailbox from the current month. By relevant I mean those that are related to the activities of Onepoint Consulting and its employees.",
    "Can you please use the onepoint-client-facing-skill to generate a draft message and send it to gil.fernandes@onepointltd.com. Please use all of the relevant emails in the mailbox from the current month. By relevant I mean those that are related to the activities of Onepoint Consulting and its employees."
  ],
  "modelPresets": {
    "primary": {
      "model": "${AGENTS_MODEL}",
      "provider": "auto",
      "maxTokens": 32768,
      "contextWindowTokens": 131072,
      "temperature": 0.1,
      "reasoningEffort": null
    }
  }
}
