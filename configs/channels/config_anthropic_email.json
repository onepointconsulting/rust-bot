{
  "agents": {
    "workspace": "~/.rust-bot/workspace-email-gateway",
    "model": "${ANTHROPIC_API_MODEL}",
    "provider": "anthropic",
    "maxTokens": 32768,
    "contextWindowTokens": 65536,
    "temperature": 0.1,
    "maxToolIterations": 100,
    "maxToolResultChars": 16000,
    "providerRetryMode": "standard",
    "reasoningEffort": null,
    "timezone": "Europe/London",
    "dream": {
      "intervalH": 2,
      "modelOverride": null,
      "maxBatchSize": 20,
      "maxIterations": 10
    }
  },
  "channels": {
    "sendProgress": false,
    "sendToolHints": false,
    "sendMaxRetries": 3,
    "transcriptionProvider": "groq",
    "allowFrom": ["*"],
    "email": {
      "enabled": true,
      "consentGranted": true,
      "autoReplyEnabled": true,
      "imapHost": "${IMAP_HOST}",
      "imapPort": 993,
      "imapUsername": "${IMAP_USERNAME}",
      "imapPassword": "${IMAP_PASSWORD}",
      "imapMailbox": "${IMAP_MAILBOX}",
      "imapUseSsl": true,
      "smtpHost": "${SMTP_HOST}",
      "smtpPort": 587,
      "smtpUsername": "${SMTP_USERNAME}",
      "smtpPassword": "${SMTP_PASSWORD}",
      "smtpUseTls": true,
      "smtpUseSsl": false,
      "fromAddress": "${FROM_ADDRESS}",
      "allowFrom": [
        "gil.fernandes.newsletter@gmail.com",
        "gil.fernandes@gmail.com",
        "gil.fernandes@onepointltd.com"
      ]
    }
  },
  "providers": {
    "anthropic": {
      "apiKey": "${ANTHROPIC_API_KEY}",
      "apiBase": "${ANTHROPIC_API_BASE}",
      "extraHeaders": null
    }
  },
  "api": {
    "host": "127.0.0.1",
    "port": 8900,
    "timeout": 120.0
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 18790,
    "heartbeat": {
      "enabled": true,
      "intervalS": 1800,
      "keepRecentMessages": 8
    }
  },
  "tools": {
    "web": {
      "enable": true,
      "proxy": null,
      "search": {
        "provider": "brave",
        "apiKey": "${BRAVE_API_KEY}",
        "baseUrl": "",
        "maxResults": 5,
        "timeout": 30
      }
    },
    "exec": {
      "enable": true,
      "timeout": 60,
      "pathAppend": "",
      "sandbox": ""
    },
    "gmail": {
      "enable": true,
      "client_secret_path": "~/.rust-bot/workspace-email-gateway/credentials/client_secret.json",
      "token_cache_path": "~/.rust-bot/workspace-email-gateway/credentials/token_cache.json",
      "max_results": 20
    },
    "ocr": {
      "enable": true,
      "provider": "anthropic",
      "apiKey": "${ANTHROPIC_API_KEY}",
      "model": "${ANTHROPIC_API_MODEL}",
      "baseUrl": "${ANTHROPIC_API_BASE}"
    },
    "docx": {
      "enable": true
    },
    "restrictToWorkspace": false,
    "mcpServers": {},
    "ssrfWhitelist": [
      "100.64.0.0/10",
      "192.168.0.0/16"
    ]
  },
  "subagent": {
    "fail_on_tool_error": false
  }
}